# Safe paper/demo runtime placeholders. Never add real credentials here.
PAPER_TRADING=true
LIVE_TRADING=false
BROKER_ENV=demo
BROKER_PROVIDER=oanda
BROKER_ENDPOINT=https://api-fxpractice.oanda.com
BROKER_TOKEN=replace-with-demo-token
# Optional MT5 demo credentials; omitted values use the local paper feed.
# BROKER_ACCOUNT=demo-account-id
# BROKER_SERVER=Exness-MT5Trial
DAILY_DRAWDOWN_LIMIT=0.05
TICK_INTERVAL_SECONDS=60
# Optional paper-risk inputs; omitted BUY/SELL signals fail closed.
# ACCOUNT_EQUITY=10000
# SESSION_START_EQUITY=10000
# RISK_STOP_DISTANCE=0.001
DATABASE_URL=postgresql://trading_bot:local-development-only@postgres:5432/trading_bot
DATA_DIR=data
LOG_DIR=logs
SENTIMENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY is intentionally omitted; inject it only at runtime if required.
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=local-development-only
