# Safe paper/demo runtime placeholders. Never add real credentials here.
PAPER_TRADING=true
LIVE_TRADING=false
TRADING_MODE=SIMULATED
BROKER_ENV=demo
BROKER_PROVIDER=exness_mt5
# Required only for BROKER_DEMO; Option B uses the Windows host bridge.
# EXNESS_BRIDGE_HOST=host.docker.internal
# EXNESS_BRIDGE_PORT=18812
# EXNESS_SERVER=Exness-MT5Trial17
# EXNESS_LOGIN=demo-account-id
# EXNESS_PASSWORD=inject-at-runtime-only
# BROKER_ENDPOINT=https://host.docker.internal:18812
# BROKER_TOKEN=inject-at-runtime-only
# BROKER_ACCOUNT=demo-account-id
# BROKER_SERVER=Exness-MT5Trial17
#
# The bridge must provide HTTPS JSON RPC endpoints and /health. Never place
# credentials in this file.
INSTRUMENT=XAUUSDm
# XAUUSDm is the verified Exness MT5 micro-lot instrument target.
# Legacy schema keys are accepted only for compatibility; paired canonical
# keys must agree.
# BROKER_TYPE=exness_mt5
# EXNESS_SYMBOL_SUFFIX=m
# DEFAULT_SYMBOL=XAUUSDm
# MAX_SPREAD_TOLERANCE=0.35
# MAX_SLIPPAGE_PIPS=2.0
# SQLITE_DB_PATH=data/session_metrics.db
DAILY_DRAWDOWN_LIMIT=0.01
FORWARD_TEST_ENABLED=false
FORWARD_TEST_WINDOW_START_UTC=13:00
FORWARD_TEST_WINDOW_END_UTC=16:00
ALERT_ROUTE=structured_log
# Set ALERT_ROUTE=webhook only with an operator-injected HTTPS URL.
# ALERT_WEBHOOK_URL=https://inject-at-runtime-only
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
#
# Multi-day duration, readiness preflight, and reconciliation deadline remain
# operator-runbook values until the forward-test controller is enabled.
TICK_INTERVAL_SECONDS=60
# Optional paper-risk inputs; omitted BUY/SELL signals fail closed.
ACCOUNT_EQUITY=10000
SESSION_START_EQUITY=10000
MAX_DATA_AGE_SECONDS=300
MAX_CLOCK_DRIFT_SECONDS=5
# Set a positive instrument-price spread tolerance to halt wide markets.
MAX_SPREAD=0
# RISK_STOP_DISTANCE=0.001
DATABASE_URL=postgresql://trading_bot:local-development-only@postgres:5432/trading_bot
DATA_DIR=data
LOG_DIR=logs
SENTIMENT_PROVIDER=ollama
SENTIMENT_INTERVAL_SECONDS=900
SENTIMENT_THRESHOLD=0.50
# Approved public economic-calendar input; the worker refreshes this snapshot.
NEWS_EVENTS_PATH=data/news_events.json
NEWS_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
NEWS_REFRESH_SECONDS=900
NEWS_MAX_AGE_SECONDS=3600
HISTORICAL_CALENDAR_PROVIDER=eodhd
HISTORICAL_CALENDAR_URL=https://eodhd.com/api/economic-events
# HISTORICAL_CALENDAR_API_KEY is required only for historical imports.
# HISTORICAL_CALENDAR_API_KEY=
HISTORICAL_CALENDAR_ARCHIVE_PATH=data/historical_calendar
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OPENAI_API_KEY is intentionally omitted; inject it only at runtime if required.
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=local-development-only
